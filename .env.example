PROJECT_NAME=turing-pattern
STACK_NAME=turing
TAG=dev
DOMAIN=turing.tobiasbrownheft.xyz

# Local Compose stays private by default. For deliberate LAN testing, set the bind
# address to 0.0.0.0 and add the exact phone-facing origin to the allowlist, e.g.
# http://192.168.1.71:3000. The backend itself remains loopback-only.
TURING_LOCAL_BIND_ADDRESS=127.0.0.1
TURING_LOCAL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Start conservatively and tune from measurements on the production host.
TURING_MAX_COMPUTE_JOBS=2
TURING_MAX_COMPUTE_WAITERS=2
TURING_COMPUTE_WORKERS=2
TURING_ADMISSION_TIMEOUT_SECONDS=0.25
TURING_IDLE_TIMEOUT_SECONDS=600
TURING_FRAME_RATE=10
TURING_STEPS_PER_FRAME=25
# Conservative P2 render-planning limits. The throughput value is the measured
# 256 x 256 OptiPlex result and drives an estimate, never an admission guarantee.
TURING_MAX_RENDER_SIMULATION_PIXELS=1048576
TURING_MAX_RENDER_OUTPUT_EDGE=4096
TURING_BENCHMARK_ITERATIONS_PER_SECOND=421.2
TURING_MAX_RENDER_QUEUE=3
TURING_MAX_RENDER_JOBS_PER_CLIENT=2
TURING_RENDER_JOB_TIMEOUT_SECONDS=900
TURING_RENDER_ARTIFACT_TTL_SECONDS=86400
TURING_MAX_RENDER_ARTIFACTS=8
TURING_MAX_RENDER_JOB_HISTORY=64
TURING_RENDER_CHUNK_STEPS=100
TURING_LOG_LEVEL=INFO

# Optional privacy-conscious daily report. See REPORTING.md. Cloudflare and SMTP
# credentials live in files under TURING_REPORT_SECRETS_DIR, never in this file.
TURING_REPORT_TIMEZONE=America/Los_Angeles
TURING_REPORT_TO=
TURING_REPORT_FROM=
TURING_SMTP_HOST=
TURING_SMTP_PORT=587
TURING_SMTP_SECURITY=starttls
TURING_SMTP_USER=
TURING_CLOUDFLARE_ZONE_ID=
TURING_REPORT_SECRETS_DIR=./secrets/reporting

# The OptiPlex benchmark found no speed benefit from native thread pools. Keep
# one native thread per bounded Python compute worker to avoid oversubscription.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1

BACKEND_CPU_LIMIT=4.0
BACKEND_MEMORY_LIMIT=2g
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEMORY_LIMIT=256m
